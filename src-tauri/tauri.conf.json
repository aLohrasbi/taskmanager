{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tempo",
  "version": "0.1.0",
  "identifier": "com.alohrasbi.tempo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      { "label": "main", "title": "Tempo", "width": 1240, "height": 820, "minWidth": 900, "minHeight": 600, "center": true },
      { "label": "week", "title": "Tempo · Week", "width": 820, "height": 430, "decorations": false, "transparent": true, "alwaysOnBottom": true, "skipTaskbar": true, "shadow": false, "visible": false },
      { "label": "next7", "title": "Tempo · Focus", "width": 360, "height": 640, "decorations": false, "transparent": true, "alwaysOnBottom": true, "skipTaskbar": true, "shadow": false, "visible": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
